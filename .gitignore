.claude/
node_modules/
.env*
test-screenshot*.png
test-results/
playwright-report/
# Pinned lint binaries, fetched on demand by scripts/lint.mjs.
.tools/

# find-finalizable.mjs writes active-<org>.json into the working directory;
# daily-activity.yml uploads them as artifacts. Running the script locally (or
# importing it with no ORG set, which yields active-undefined.json) must not
# leave something a `git add -A` can commit.
active-*.json

# Wrangler's local state for cors-worker/. `wrangler deploy` and `wrangler dev`
# create it beside the config, it is caches and build state rather than source,
# and this repo is PUBLIC - so it must not be something a `git add -A` can
# commit. Same reasoning as active-*.json above: the fix is to ignore the path
# before anything lands in it, not after.
.wrangler/
