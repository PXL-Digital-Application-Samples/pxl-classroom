{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pxl-classroom.github.io/schemas/observation.schema.json",
  "title": "Observation",
  "description": "A point-in-time observation of a student repository's state, stored in observations/<assignment-id>/<login>/<timestamp>.json: a snapshot of the submission branch. (A second variant, for submit tags, was removed with them on 2026-10-14; the report ignores any such file.)",
  "type": "object",
  "oneOf": [
    {
      "title": "Snapshot observation (default-branch tip).",
      "type": "object",
      "required": [
        "schema_version",
        "assignment_id",
        "github_login",
        "repo_id",
        "observed_at",
        "ref",
        "sha",
        "collection_type"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "integer", "const": 1 },
        "type": { "type": "string", "const": "snapshot" },
        "assignment_id": { "type": "string", "minLength": 1 },
        "github_login": { "type": "string", "minLength": 1 },
        "repo_id": { "type": "integer" },
        "observed_at": { "type": "string", "format": "date-time" },
        "ref": { "type": "string", "minLength": 1 },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "commit_count": { "type": ["integer", "null"], "minimum": 0 },
        "commit_date": { "type": ["string", "null"], "format": "date-time" },
        "late_commit_count": { "type": ["integer", "null"], "minimum": 0 },
        "commit_message": { "type": ["string", "null"] },
        "author_name": { "type": ["string", "null"] },
        "author_email": { "type": ["string", "null"] },
        "observer_run": { "type": "string", "format": "uri" },
        "collection_type": {
          "type": "string",
          "enum": ["scheduled", "manual", "deadline", "lockdown", "preservation"]
        }
      }
    }
  ]
}
