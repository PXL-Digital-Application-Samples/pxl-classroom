{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pxl-classroom.github.io/schemas/report.schema.json",
  "title": "Deadline Report",
  "description": "A deadline report for an assignment, stored in reports/<assignment-id>.json.",
  "type": "object",
  "required": [
    "schema_version",
    "assignment_id",
    "students"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for forward compatibility."
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1,
      "description": "ID of the assignment this report covers."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this report was generated."
    },
    "generator_version": {
      "type": "string",
      "description": "Version of the report generator that produced this report."
    },
    "source_revision": {
      "type": "string",
      "description": "Git commit SHA of the control repo at generation time."
    },
    "live_refreshed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last frontend Live Status refresh. Populated by the Admin UI; overwritten on next backend export."
    },
    "live_refreshed_by": {
      "type": [
        "string",
        "null"
      ],
      "description": "GitHub login of the lecturer who triggered the last Live Status refresh."
    },
    "teams": {
      "type": "array",
      "description": "Per-team summary for group assignments.",
      "items": {
        "type": "object",
        "required": [
          "team_slug",
          "team_name",
          "members"
        ],
        "properties": {
          "team_slug": {
            "type": "string"
          },
          "team_name": {
            "type": "string"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "repo_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "repo_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "repo_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "submission_status": {
            "type": "string",
            "enum": [
              "on-time",
              "late",
              "no-submission",
              "unknown"
            ]
          },
          "latest_observed_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "commit_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "lock_down_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "preservation_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "preserved_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "under_capacity": {
            "type": "boolean"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "seeded_from": {
            "type": "object",
            "description": "Provenance carried over from teams/<id>/<slug>.json when the team was seeded rather than student-formed."
          }
        }
      }
    },
    "students": {
      "type": "array",
      "description": "Per-student submission summary.",
      "items": {
        "type": "object",
        "required": [
          "github_login"
        ],
        "additionalProperties": false,
        "properties": {
          "github_login": {
            "type": "string",
            "minLength": 1,
            "description": "GitHub username of the student."
          },
          "team_slug": {
            "type": [
              "string",
              "null"
            ],
            "description": "Team slug if the student is in a team for a group assignment."
          },
          "team_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name of the team if in a group assignment."
          },
          "student_number": {
            "type": [
              "string",
              "null"
            ],
            "description": "Institutional student number, if linked via roster."
          },
          "full_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Full name from the roster."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Institutional student email, if linked via roster."
          },
          "class_group": {
            "type": [
              "string",
              "null"
            ],
            "description": "Student class group, if linked via roster."
          },
          "author_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Git commit author name from repository commits."
          },
          "author_email": {
            "type": [
              "string",
              "null"
            ],
            "description": "Git commit author email from repository commits."
          },
          "acceptance_state": {
            "type": "string",
            "description": "Acceptance status of the student for this assignment."
          },
          "repo_id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "GitHub repository ID, if a repo exists."
          },
          "repo_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Full repository name in org/repo format."
          },
          "repo_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "HTML URL of the student's repository."
          },
          "submission_status": {
            "type": "string",
            "enum": [
              "on-time",
              "late",
              "no-submission",
              "unknown"
            ],
            "description": "Whether the submission was on time, late, missing, or indeterminate."
          },
          "last_on_time_sha": {
            "type": [
              "string",
              "null"
            ],
            "description": "SHA of the last commit observed before the deadline."
          },
          "last_on_time_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp of the last on-time observation."
          },
          "first_late_sha": {
            "type": [
              "string",
              "null"
            ],
            "description": "SHA of the first commit observed after the deadline."
          },
          "first_late_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp of the first late observation."
          },
          "latest_observed_sha": {
            "type": [
              "string",
              "null"
            ],
            "description": "SHA of the most recent observation regardless of timing."
          },
          "latest_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp of the most recent observation."
          },
          "commit_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Actual author/committer timestamp of the latest commit."
          },
          "latest_commit_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Actual author/committer timestamp of the latest commit."
          },
          "commit_message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Commit message of the latest observed commit."
          },
          "latest_commit_message": {
            "type": [
              "string",
              "null"
            ],
            "description": "Commit message of the latest observed commit."
          },
          "commit_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "Total commit count on the submission ref. Populated by backend collection and frontend refresh."
          },
          "uncertainty_interval_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "Seconds between the last on-time and first late observation. Indicates confidence in the deadline boundary."
          },
          "tagged_submission_tag": {
            "type": [
              "string",
              "null"
            ],
            "description": "Full tag name of the latest observed submit/ tag."
          },
          "tagged_submission_sha": {
            "type": [
              "string",
              "null"
            ],
            "description": "SHA of the commit pointed to by the latest submit/ tag."
          },
          "tagged_submission_observed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp when the submit/ tag was observed."
          },
          "tagged_submission_declared_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Declared student timestamp parsed from the submit/ tag name."
          },
          "lock_down_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Timestamp when the repository was locked down."
          },
          "lock_down_outcome": {
            "type": [
              "string",
              "null"
            ],
            "description": "Outcome of the lock-down operation."
          },
          "preservation_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "preserved",
              "pending",
              "failed",
              "not-required",
              null
            ],
            "description": "Status of the deadline snapshot preservation."
          },
          "preserved_sha": {
            "type": [
              "string",
              "null"
            ],
            "description": "SHA of the preserved deadline snapshot."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Human-readable warnings about this student's submission."
          }
        }
      }
    }
  }
}
