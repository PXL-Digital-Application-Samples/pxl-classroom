{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pxl-classroom.github.io/schemas/sync-record.schema.json",
  "title": "Starter Code Sync Record",
  "description": "A record of a starter code synchronization run, stored in syncs/<assignment-id>/<sync-id>.json in the control repository.",
  "type": "object",
  "required": [
    "schema_version",
    "sync_id",
    "assignment_id",
    "synced_at",
    "synced_by",
    "template_repo",
    "template_sha",
    "selected_files",
    "summary",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for forward compatibility."
    },
    "sync_id": {
      "type": "string",
      "pattern": "^sync-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6}$",
      "description": "Unique timestamped identifier for this sync run."
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "synced_by": {
      "type": "string",
      "description": "GitHub login of the lecturer who triggered the sync."
    },
    "template_repo": {
      "type": "string",
      "description": "Source template repository (owner/repo)."
    },
    "template_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Commit SHA from the template repository that was synchronized."
    },
    "selected_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of file paths selectively synced from the template, or ['*'] for full commit tree."
    },
    "pr_title": {
      "type": "string"
    },
    "pr_body": {
      "type": "string"
    },
    "created_issues": {
      "type": "boolean",
      "default": false
    },
    "summary": {
      "type": "object",
      "required": ["total", "auto_merged", "pr_opened", "skipped", "failed"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "auto_merged": { "type": "integer", "minimum": 0 },
        "pr_opened": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["github_login", "repo_name", "outcome"],
        "additionalProperties": false,
        "properties": {
          "github_login": { "type": "string" },
          "team_slug": { "type": "string" },
          "repo_name": { "type": "string" },
          "outcome": {
            "type": "string",
            "enum": ["auto-merged", "pr-opened", "skipped-up-to-date", "skipped-no-repo", "failed"]
          },
          "commit_sha": { "type": ["string", "null"] },
          "pr_number": { "type": ["integer", "null"] },
          "pr_url": { "type": ["string", "null"] },
          "issue_number": { "type": ["integer", "null"] },
          "issue_url": { "type": ["string", "null"] },
          "error": { "type": ["string", "null"] }
        }
      }
    }
  }
}
