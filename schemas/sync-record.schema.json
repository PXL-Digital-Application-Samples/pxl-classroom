{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pxl-classroom.github.io/schemas/sync-record.schema.json",
  "title": "Starter Code Sync Record",
  "description": "A record of a starter code synchronization run, stored in syncs/<assignment-id>/<sync-id>.json in the control repository.",
  "type": "object",
  "required": [
    "schema_version",
    "sync_id",
    "assignment_id",
    "synced_at",
    "synced_by",
    "template_repo",
    "template_sha",
    "selected_files",
    "summary",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for forward compatibility."
    },
    "sync_id": {
      "type": "string",
      "pattern": "^sync-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6}$",
      "description": "Unique timestamped identifier for this sync run."
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "synced_at": {
      "type": "string",
      "format": "date-time"
    },
    "synced_by": {
      "type": "string",
      "description": "GitHub login of the lecturer who triggered the sync."
    },
    "template_repo": {
      "type": "string",
      "description": "Source template repository (owner/repo)."
    },
    "template_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Commit SHA from the template repository that was synchronized."
    },
    "template_base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "That commit's parent. A student whose file still matches the base has not touched it, which is how the sync decides between writing to main and opening a pull request. Absent for a root commit."
    },
    "selected_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The paths actually applied. Previously the raw request, recorded as ['*'] while the operation merged the entire template tree regardless of what the lecturer had ticked."
    },
    "pr_title": {
      "type": "string"
    },
    "pr_body": {
      "type": "string"
    },
    "created_issues": {
      "type": "boolean",
      "default": false
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "auto_merged",
        "pr_opened",
        "skipped",
        "failed"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "auto_merged": {
          "type": "integer",
          "minimum": 0
        },
        "pr_opened": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "github_login",
          "repo_name",
          "outcome"
        ],
        "additionalProperties": false,
        "properties": {
          "github_login": {
            "type": "string"
          },
          "team_slug": {
            "type": "string"
          },
          "repo_name": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "auto-merged",
              "pr-opened",
              "merged-and-pr",
              "skipped-up-to-date",
              "skipped-no-repo",
              "failed"
            ],
            "description": "`merged-and-pr` exists because the clean/conflict split is per FILE: one sync can put three corrections straight onto a student's main and raise a pull request for the fourth. Such a student is counted in both auto_merged and pr_opened, so the summary counters deliberately do not sum to total."
          },
          "files_merged": {
            "type": "integer",
            "minimum": 0,
            "description": "Files written directly to main because the student had not touched them."
          },
          "files_conflicted": {
            "type": "integer",
            "minimum": 0,
            "description": "Files the student had changed, offered as a pull request instead."
          },
          "commit_sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "pr_number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "pr_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "issue_number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "issue_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "issue_error": {
            "type": "string",
            "description": "Why the notification issue could not be created. The issue IS how a student learns a starter-code pull request is waiting, so a failure to open one has to reach the record a lecturer reads - not just the run log."
          }
        }
      }
    }
  }
}
