{
  "name": "pxl-classroom-actions",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Shared dependencies for PXL Classroom composite actions and scripts",
  "type": "module",
  "imports": {
    "#deployment": "./lib/deployment.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.mjs cli/tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.11.0"
  }
}
