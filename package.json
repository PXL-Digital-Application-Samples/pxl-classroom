{
  "name": "pxl-classroom-actions",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Shared dependencies for PXL Classroom composite actions and scripts",
  "type": "module",
  "imports": {
    "#deployment": "./lib/deployment.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "cli"
  ],
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.mjs cli/tests/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage tests/*.test.mjs cli/tests/*.test.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "types": "node scripts/generate-types.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm test && npm run test:e2e",
    "prepare": "husky || exit 0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "typescript": "^7.0.2"
  }
}
